# Copy to .env before `docker compose up`.

# --- Database -------------------------------------------------------------
DB_NAME=elcorix
DB_USER=elcorix
# Change both of these before anything leaves your laptop.
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# --- Site -----------------------------------------------------------------
WEB_PORT=8080
# Must match how the site is actually reached, or WordPress will redirect
# every request to the wrong host.
SITE_URL=http://localhost:8080

# Set to true in production: it stops plugin/theme installs and updates
# from inside wp-admin, so a compromised account cannot write PHP.
DISALLOW_FILE_MODS=false

# --- Backups --------------------------------------------------------------
BACKUP_KEEP_DAYS=14

# --- Everything else ------------------------------------------------------
# The Altegio company id, the notification e-mail address, the retention
# window and all the business data live in the database, editable under
# Settings → elcorix. They are deliberately NOT environment variables: the
# studio has to be able to change a phone number without a redeploy.
