# TLS termination for the containerized stack (docker-compose.tls.yml).
# Caddy redirects HTTP→HTTPS and manages Let's Encrypt automatically.
{
	email {$ACME_EMAIL}
}

# All three domains serve the site directly — no cross-domain redirects.
# elcorix.de is the main domain: every page's canonical and hreflang tags
# and the sitemap point at it (siteUrl in client/src/business.ts), so
# search engines index .de and treat .com/.eu as the same site rather
# than duplicate content.
elcorix.de, elcorix.com, elcorix.eu {
	# HSTS only over HTTPS — nginx must not set it (it serves plain HTTP
	# inside the network). 6 months, extend once the setup is proven.
	header Strict-Transport-Security "max-age=15552000"
	reverse_proxy client:80
}

# www.<domain> → <domain>, keeping the TLD the visitor typed.
# {labels.1}.{labels.0} is "elcorix" + "." + "com"/"de"/"eu".
www.elcorix.de, www.elcorix.com, www.elcorix.eu {
	redir https://{labels.1}.{labels.0}{uri} permanent
}
