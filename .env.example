# Server
PORT=3001
DATABASE_URL=postgres://postgres:postgres@localhost:5432/kosmetic

# Security (see SECURITY.md)
# Exact origins allowed to call the API cross-origin, comma-separated.
# Leave empty when client and API share an origin (recommended).
CORS_ALLOWED_ORIGINS=
# Number of reverse-proxy hops in front of the API (enables correct client
# IPs for rate limiting). Leave empty when not behind a proxy.
TRUST_PROXY_HOPS=

# Altegio (https://alteg.io) — your company/branch booking id
ALTEGIO_COMPANY_ID=000000
# The online-booking block (landing section + /booking route + the embed)
# is hidden by default. Set to "true" at BUILD time to bring it back; the
# code is all still there. See client/src/features.ts.
VITE_ENABLE_ALTEGIO=false
# Optional: Altegio API credentials for server-side integration
ALTEGIO_API_TOKEN=

# E-mail notifications (contact form + booking requests). All of SMTP_HOST,
# MAIL_FROM and MAIL_TO are required to enable sending; otherwise requests
# are only stored in Postgres. Staff notifications go to MAIL_TO; customers
# get a localized confirmation of receipt.
SMTP_HOST=
SMTP_PORT=587
# "true" for implicit TLS (port 465); STARTTLS is used otherwise.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM="elcorix <no-reply@elcorix.com>"
MAIL_TO=info@elcorix.com

# Telegram notifications (consultation form only). Both variables are
# required to enable them; without them the request is still stored in
# Postgres and e-mailed. Setup: talk to @BotFather, /newbot, copy the token
# below; then add the bot to the studio group (or message it directly),
# send it one message, and read the chat id from
#   https://api.telegram.org/bot<TOKEN>/getUpdates
# (result[].message.chat.id — group ids are negative). Treat the token like
# a password: anyone holding it can post as the bot and read the chat.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# GDPR retention: stored contact messages and booking requests are deleted
# after this many months (daily cleanup job). The privacy policy promises at
# most 6; the server caps larger values at 6.
RETENTION_MONTHS=6

# Docker Compose (docker-compose.yml reads this file automatically)
# Postgres password for the db service — change for anything non-local.
POSTGRES_PASSWORD=kosmetic
# Host port the site is served on (nginx container).
WEB_PORT=8080
# Days of nightly pg_dump files kept in ./backups.
BACKUP_KEEP_DAYS=14

# Off-site backups (offsite-backup service, `--profile offsite`): restic
# repository and its encryption password — keep a copy of the password
# outside the server, without it the backups cannot be restored.
# Setup: SECURITY.md → "Off-site backups".
RESTIC_REPOSITORY=sftp:storagebox:elcorix-restic
RESTIC_PASSWORD=
# How long off-site snapshots are kept (restic --keep-within).
OFFSITE_KEEP=14d

# TLS (docker-compose.tls.yml overlay): the public hostname Caddy obtains
# a Let's Encrypt certificate for, and the admin e-mail for expiry notices.
SITE_DOMAIN=elcorix.com
ACME_EMAIL=info@elcorix.com

# Self-hosted Umami analytics (README → "Analytics (Umami)").
# Enable the services with the compose profile — combine with others as
# needed, e.g. COMPOSE_PROFILES=analytics,offsite
#COMPOSE_PROFILES=analytics
# Hex only (openssl rand -hex 32): the DB password is part of a URL.
UMAMI_DB_PASSWORD=
UMAMI_APP_SECRET=
# Optional: enables two-factor login on the dashboard (openssl rand -hex 32).
UMAMI_2FA_KEY=
# The id of the website created in the dashboard (Settings → Websites).
# Empty = the client is built without the tracker and the privacy policy
# without its analytics section. Rebuild the client after setting it:
#   docker compose up -d --build client
UMAMI_WEBSITE_ID=
# Hostnames the tracker counts on (anything else — localhost, previews —
# is ignored). Default: elcorix.com,elcorix.de,elcorix.eu
#UMAMI_DOMAINS=
# Raw analytics data older than this is deleted daily (privacy policy).
UMAMI_RETENTION_MONTHS=14
# Loopback port of the dashboard on the host (SSH tunnel / local runs).
#UMAMI_PORT=3002
