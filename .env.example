# Server
PORT=3001
DATABASE_URL=postgres://postgres:postgres@localhost:5432/kosmetic

# Security (see SECURITY.md)
# Exact origins allowed to call the API cross-origin, comma-separated.
# Leave empty when client and API share an origin (recommended).
CORS_ALLOWED_ORIGINS=
# Number of reverse-proxy hops in front of the API (enables correct client
# IPs for rate limiting). Leave empty when not behind a proxy.
TRUST_PROXY_HOPS=

# Altegio (https://alteg.io) — your company/branch booking id
ALTEGIO_COMPANY_ID=000000
# Optional: Altegio API credentials for server-side integration
ALTEGIO_API_TOKEN=
